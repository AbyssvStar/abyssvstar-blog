# 复制成 .env 后按需修改。

# ---- 数据库 ----
POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=change-me            # 【必填】

# ---- 对象存储 / 图床（MinIO 自建）----
# 这两个既是 MinIO 的 root 凭据，也是应用访问 MinIO 的凭据
MINIO_ROOT_USER=blog-minio                     # 【必填】
MINIO_ROOT_PASSWORD=change-me-minio            # 【必填】至少 8 位
MINIO_BUCKET=blog-media                        # 可选，默认 blog-media
# 图片对外的访问前缀。生产环境应该是 https://你的域名/media
BLOG_STORAGE_PUBLIC_BASE_URL=https://blog.example.com/media

# ---- 管理员账号（首次启动时自动创建；已存在则不会覆盖密码）----
BLOG_ADMIN_USERNAME=admin                      # 可选，默认 admin
BLOG_ADMIN_PASSWORD=change-me-too              # 【必填】为空则跳过建号，后台登不进去

# ---- 站点对外地址（RSS / sitemap / OG 的绝对 URL）----
BLOG_BASE_URL=https://blog.example.com         # 可选，默认 http://localhost:3000

# ---- 运行环境 ----
SPRING_PROFILES_ACTIVE=prod
BLOG_COOKIE_SECURE=true                        # 本地 http 调试要设成 false
# BLOG_IP_SALT=      # 影响 IP 哈希，换掉后已有计数会重置
# BLOG_RATE_LIMIT_ENABLED=true                 # 本地调试可设 false，免得被自己限流
 ---- 暂不需要----
# BLOG_EXPORT_TOKEN=                           # G2：CI 拉全量内容用
# APP_IMAGE=
